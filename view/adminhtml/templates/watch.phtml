                        <button type="submit" class="action-secondary"><?= $block->escapeHtml(__('Połącz kluczem')) ?></button>
                    </div>
                </form>
            </div>
        </div>
    <?php else: ?>
        <div class="cfx-card">
            <h2><?= $block->escapeHtml(__('Połączono z Calmfox Watch')) ?></h2>
            <p>
                <?= $block->escapeHtml(__('Sklep %1, pakiet %2.', $block->getDomain(), $state['plan'] ?? 'Free')) ?>
                <?php $lastPoll = $block->getLastPollAt(); ?>
                <?php if ($lastPoll !== null): ?>
                    <?= $block->escapeHtml(__('Ostatnie odpytanie monitoringu: %1.', $block->formatMoment(gmdate('c', $lastPoll)))) ?>
                <?php else: ?>
                    <?= $block->escapeHtml(__('Monitoring jeszcze nie odpytał adresu kontrolnego, pierwsze sprawdzenie w ciągu kilku minut.')) ?>
