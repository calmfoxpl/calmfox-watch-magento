        .cfx-watch .cfx-fix-label { display: block; font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: #6b7280; margin-bottom: .2rem; }
        .cfx-watch .cfx-fix-command { display: block; margin-top: .4rem; padding: .4rem .5rem; background: #0f172a; color: #e2e8f0; border: 0; white-space: pre-wrap; word-break: break-all; user-select: all; }
