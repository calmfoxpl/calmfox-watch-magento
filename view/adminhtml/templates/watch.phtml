            )) ?>
        </div>
    <?php endif; ?>

    <?php if (!$block->isConnected()): ?>
        <p><?= $block->escapeHtml(__('Monitoring wnętrza sklepu: dostępność usług (baza danych, poczta, dysk, kolejki, indeksy, wyszukiwarka), warunki złożenia zamówienia, podstawowe zasady bezpieczeństwa i historia zmian wersji. Wyniki znajdziesz w panelu Calmfox Watch.')) ?></p>

