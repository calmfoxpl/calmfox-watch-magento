    <h1><?= $block->escapeHtml(__('Calmfox Watch')) ?></h1>
    <p class="cfx-version"><?= $block->escapeHtml(__('wersja %1', $block->getVersion())) ?></p>

    <?php if (!$loopback['ok']): ?>
