                <form method="post" action="<?= $block->escapeUrl($block->getActionUrl('connect')) ?>">
                    <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKeyValue()) ?>">
                    <div class="cfx-actions">
                        <button type="submit" class="action-primary"><?= $block->escapeHtml(__('Połącz przez Calmfox Watch')) ?></button>
                    </div>
                </form>
            </div>
        <?php endif; ?>

        <div class="cfx-grid">
            <div class="cfx-card">
                <h2><?= $block->escapeHtml(__('Nie mam konta, załóż pakiet Free')) ?></h2>
                <p class="cfx-detail"><?= $block->escapeHtml(__('Konto zakładamy od razu: monitoring dostępności sklepu, certyfikatu SSL i stanu usług. Bez hasła, logowanie linkiem wysyłanym na adres e-mail.')) ?></p>
                <form method="post" action="<?= $block->escapeUrl($block->getActionUrl('register')) ?>">
                    <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKeyValue()) ?>">
                    <label for="cfx-email"><?= $block->escapeHtml(__('Adres e-mail właściciela')) ?></label>
                    <input type="email" id="cfx-email" name="email" required>
                    <p style="margin-top:.75rem;">
                        <label style="font-weight:400;">
                            <input type="checkbox" name="consent" value="1" required>
                            <?= $block->escapeHtml(__('Zgadzam się na przekazanie adresu e-mail i domeny sklepu do Calmfox w celu założenia konta monitoringu.')) ?>
                        </label>
                    </p>
                    <div class="cfx-actions">
                        <button type="submit" class="action-primary"><?= $block->escapeHtml(__('Aktywuj pakiet Free')) ?></button>
                    </div>
                </form>
            </div>

            <div class="cfx-card">
                <h2><?= $block->escapeHtml(__('Mam już konto, połącz kluczem')) ?></h2>
                <p class="cfx-detail"><?= $block->escapeHtml(__('Klucz instalacyjny znajdziesz na ekranie Integracje w panelu Calmfox Watch, przy stronie tego sklepu.')) ?></p>
                <form method="post" action="<?= $block->escapeUrl($block->getActionUrl('pair')) ?>">
                    <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKeyValue()) ?>">
                    <label for="cfx-token"><?= $block->escapeHtml(__('Klucz instalacyjny')) ?></label>
                    <input type="text" id="cfx-token" name="token" placeholder="fxp_live_…" required>
