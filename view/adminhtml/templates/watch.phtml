                            <strong><?= $block->escapeHtml($entry['name'] ?? '') ?></strong>
                            <span class="cfx-detail">(<?= $block->escapeHtml($kindLabels[$entry['kind'] ?? ''] ?? ($entry['kind'] ?? '')) ?>)</span>
                        </td>
                        <td><?= $block->escapeHtml(trim((!empty($entry['from']) ? $entry['from'].' → ' : '').($entry['to'] ?? ''))) ?></td>
                    </tr>
                <?php endforeach; ?>
            </table>
        <?php endif; ?>
