        .cfx-watch label { display: block; font-weight: 600; margin-bottom: .25rem; }
        .cfx-watch input[type="text"], .cfx-watch input[type="email"] { width: 100%; max-width: 380px; padding: .45rem .6rem; border: 1px solid #cbd5e1; border-radius: 6px; }
        .cfx-watch .cfx-actions { margin-top: .75rem; display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }
        .cfx-watch .cfx-actions form { margin: 0; }
