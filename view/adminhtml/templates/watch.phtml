                <form method="post" action="<?= $block->escapeUrl($block->getActionUrl('refresh')) ?>">
                    <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKeyValue()) ?>">
                    <button type="submit" class="action-secondary"><?= $block->escapeHtml(__('Przelicz teraz')) ?></button>
                </form>
                <form method="post" action="<?= $block->escapeUrl($block->getActionUrl('rotate')) ?>">
                    <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKeyValue()) ?>">
