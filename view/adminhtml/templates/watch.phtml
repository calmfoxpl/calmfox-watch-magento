<?php
/**
 * Ekran Calmfox Watch w panelu Magento.
 *
 * Style są własne i wąskie (prefiks .cfx-), bo moduł nie może zakładać, że
 * panel ma akurat ten motyw administracyjny, co u nas w testach. Wszystko,
 * co pokazujemy, pochodzi z payloadu wysyłanego do huba: ekran ma mówić
 * dokładnie to samo, co panel Calmfox, a nie własną wersję prawdy.
 *
 * @var \Calmfox\Watch\Block\Adminhtml\Watch $block
 */
$health = $block->getHealth();
$security = $block->getSecurity();
$state = $block->getState();
$loopback = $block->getLoopback();
$statusLabels = ['ok' => __('OK'), 'warn' => __('uwaga'), 'fail' => __('awaria')];
$kindLabels = ['core' => __('platforma'), 'plugin' => __('pakiet'), 'theme' => __('motyw')];
?>
<div class="cfx-watch">
    <style>
        .cfx-watch { max-width: 1100px; }
        .cfx-watch h1 { font-size: 1.7rem; margin: 0 0 .25rem; }
        .cfx-watch h2 { font-size: 1.1rem; margin: 0 0 .75rem; }
        .cfx-watch .cfx-version { color: #6b7280; font-size: .85rem; margin-bottom: 1rem; }
        .cfx-watch .cfx-card { border: 1px solid #e5e7eb; border-radius: 10px; padding: 1rem 1.25rem; margin: 1rem 0; background: #fff; }
        .cfx-watch .cfx-grid { display: flex; flex-wrap: wrap; gap: 1rem; }
        .cfx-watch .cfx-grid > .cfx-card { flex: 1 1 320px; margin: 0; }
        .cfx-watch .cfx-badge { display: inline-block; padding: .1rem .55rem; border-radius: 999px; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }
        .cfx-watch .cfx-ok { background: #dcfce7; color: #14532d; }
        .cfx-watch .cfx-warn { background: #fef3c7; color: #78350f; }
        .cfx-watch .cfx-fail { background: #fee2e2; color: #7f1d1d; }
