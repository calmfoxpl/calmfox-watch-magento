    <?php /*
        Pakiet sklepu. Zakup dzieje się w panelu (subskrypcja per strona), moduł tylko
        prowadzi do właściwego miejsca w kontekście TEGO sklepu. Pakiet pokazujemy
        z zastrzeżeniem, bo znamy go z chwili połączenia; źródłem prawdy jest panel.
    */ ?>
    <?php if ($block->isConnected()): ?>
        <div class="cfx-card">
            <?php if ($block->isFreePlan()): ?>
                <h2><?= $block->escapeHtml(__('Pakiet Free, co dokłada wyższy próg')) ?></h2>
                <p class="cfx-detail"><?= $block->escapeHtml(__('Na Free pilnujemy dostępności sklepu, certyfikatu i stanu usług. Wyższe pakiety dokładają to, czego Free nie obejmuje:')) ?></p>
                <ul class="cfx-plan-list">
                    <li><?= $block->escapeHtml(__('sondy co 30 do 60 sekund zamiast co 5 minut, awarię widać od razu, nie po kwadransie')) ?></li>
                    <li><?= $block->escapeHtml(__('przegląd podstron: urwane treści, błędy 404 i zepsute odnośniki, zanim zauważy je klient')) ?></li>
                    <li><?= $block->escapeHtml(__('monitoring wybranych podstron i ścieżki zakupowej, nie tylko strony głównej')) ?></li>
                    <li><?= $block->escapeHtml(__('powiadomienia SMS-em, w komunikatorze i w aplikacji, bez miesięcznego limitu')) ?></li>
                    <li><?= $block->escapeHtml(__('raporty okresowe i dłuższa historia zdarzeń')) ?></li>
                </ul>
                <div class="cfx-actions">
                    <a class="action-primary" href="<?= $block->escapeUrl($block->getPlanUrl()) ?>" target="_blank" rel="noopener"><?= $block->escapeHtml(__('Zobacz pakiety dla tego sklepu')) ?></a>
                </div>
                <p class="cfx-detail"><?= $block->escapeHtml(__('Pakiet kupujesz w panelu, kartą, osobno dla każdej strony. Sklep może iść wyżej, a strona wizytówka zostać na Free.')) ?></p>
            <?php else: ?>
                <h2><?= $block->escapeHtml(__('Pakiet i płatności')) ?></h2>
                <p><?= $block->escapeHtml(__('Ten sklep jest w pakiecie %1 (stan z chwili połączenia, bieżący pakiet i płatności zobaczysz w panelu).', ucfirst($block->getPlan()))) ?></p>
                <div class="cfx-actions">
                    <a class="action-secondary" href="<?= $block->escapeUrl($block->getPlanUrl()) ?>" target="_blank" rel="noopener"><?= $block->escapeHtml(__('Zarządzaj pakietem i płatnościami')) ?></a>
                </div>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <div class="cfx-card">
        <h2><?= $block->escapeHtml(__('Adres kontrolny')) ?></h2>
        <p><code><?= $block->escapeHtml($block->getHealthUrl()) ?></code></p>
        <p class="cfx-detail"><?= $block->escapeHtml(__('Ten adres odpytuje monitoring. Klucz w adresie jest jedynym zabezpieczeniem, więc nie publikuj go i nie wklejaj do zgłoszeń.')) ?></p>
    </div>

    <?php foreach ([[__('Stan usług'), $health, true], [__('Bezpieczeństwo'), $security, false]] as [$title, $payload, $withQuota]): ?>
        <div class="cfx-card">
            <h2>
                <?= $block->escapeHtml($title) ?>
                <span class="cfx-badge cfx-<?= $block->escapeHtmlAttr($payload['status']) ?>"><?= $block->escapeHtml($statusLabels[$payload['status']] ?? $payload['status']) ?></span>
            </h2>
            <?php if (empty($payload['checks'])): ?>
                <p><?= $block->escapeHtml(__('Brak sprawdzeń do pokazania.')) ?></p>
            <?php else: ?>
                <table>
                    <?php foreach ($payload['checks'] as $check): ?>
                        <tr>
                            <td style="width:6rem;"><span class="cfx-badge cfx-<?= $block->escapeHtmlAttr($check['status']) ?>"><?= $block->escapeHtml($statusLabels[$check['status']] ?? $check['status']) ?></span></td>
                            <td>
                                <strong><?= $block->escapeHtml($check['label'] ?? $check['id']) ?></strong>
                                <?php if (!empty($check['detail'])): ?><br><span class="cfx-detail"><?= $block->escapeHtml($check['detail']) ?></span><?php endif; ?>
                                <?php /* Konkret naprawczy: co ustawić i przykład do skopiowania. Polecenie
                                          w osobnym bloku, bo zwykle idzie stąd prosto do terminala albo do
                                          wiadomości do hostingodawcy. */ ?>
                                <?php if (!empty($check['fix'])): ?>
                                    <div class="cfx-fix">
                                        <span class="cfx-fix-label"><?= $block->escapeHtml(__('Jak naprawić')) ?></span>
                                        <span class="cfx-detail"><?= $block->escapeHtml($check['fix']) ?></span>
                                        <?php if (!empty($check['command'])): ?>
                                            <code class="cfx-fix-command"><?= $block->escapeHtml($check['command']) ?></code>
                                            <span class="cfx-detail"><?= $block->escapeHtml(__('Przykład do wykonania na serwerze, w katalogu sklepu. Sprawdź go u siebie przed użyciem.')) ?></span>
                                        <?php endif; ?>
                                    </div>
                                <?php endif; ?>
                            </td>
                            <td class="cfx-ms"><?= $check['ms'] !== null ? $block->escapeHtml($check['ms'].' ms') : '' ?></td>
                        </tr>
                    <?php endforeach; ?>
                </table>
            <?php endif; ?>

            <?php if ($withQuota): ?>
                <form method="post" action="<?= $block->escapeUrl($block->getActionUrl('quota')) ?>" style="margin-top:1rem;">
                    <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKeyValue()) ?>">
                    <label for="cfx-quota"><?= $block->escapeHtml(__('Limit dysku na koncie hostingowym (GB)')) ?></label>
                    <input type="text" inputmode="decimal" id="cfx-quota" name="quota" style="max-width:8rem;"
                           value="<?= $block->getDiskQuotaGb() > 0 ? $block->escapeHtmlAttr((string) $block->getDiskQuotaGb()) : '' ?>" placeholder="20">
                    <div class="cfx-actions">
                        <button type="submit" class="action-secondary"><?= $block->escapeHtml(__('Zapisz limit')) ?></button>
                    </div>
                    <p class="cfx-detail"><?= $block->escapeHtml(__('Znajdziesz go w panelu hostingu albo w umowie. Zostaw puste, jeżeli nie wiesz: wtedy pokazujemy tylko rozmiar sklepu, bez zgadywania.')) ?></p>
                </form>
            <?php endif; ?>
        </div>
    <?php endforeach; ?>

    <div class="cfx-card">
        <h2><?= $block->escapeHtml(__('Historia zmian wersji')) ?></h2>
        <p class="cfx-detail"><?= $block->escapeHtml(__('Zbierana od instalacji modułu przez porównywanie spisu pakietów. Znacznik czasu to moment wykrycia zmiany, nie moment wdrożenia.')) ?></p>
        <?php $history = $block->getHistory(); ?>
        <?php if (empty($history)): ?>
            <p><?= $block->escapeHtml(__('Brak wpisów. Pierwszy pojawi się po najbliższym wdrożeniu.')) ?></p>
        <?php else: ?>
            <table>
                <?php foreach ($history as $entry): ?>
                    <tr>
                        <td class="cfx-detail"><?= $block->escapeHtml($block->formatMoment($entry['at'] ?? null)) ?></td>
